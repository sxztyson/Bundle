{
  "schemaVersion": 1,
  "id": "map-bundle-collector",
  "version": "1.1.0",
  "name": "Bundle Sorter",
  "description": "Collects, sorts, and previews map-art bundles.",
  "authors": ["tysonsxz"],
  "environment": "client",
  "entrypoints": {
    "meteor": ["dev.mapbundlecollector.MapBundleCollectorAddon"]
  },
  "mixins": [
    "map-bundle-collector.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "82,156,255",
    "modmenu": { "parent": { "id": "meteor-client" } }
  },
  "depends": {
    "java": ">=25",
    "minecraft": "~26.2",
